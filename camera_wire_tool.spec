# PyInstaller build spec for the Camera Wire Tool.
#
#   Build:   pyinstaller --noconfirm camera_wire_tool.spec
#   Output:  dist/CameraWireTool.exe   (Windows; single-file, windowed)
#            dist/CameraWireTool       (Linux; wrapped into an AppImage by
#                                       packaging/linux/build_appimage.sh)
#
# The app is a Tkinter GUI; `console=False` keeps a command window from
# popping up behind it. sv_ttk's theme files are collected explicitly so
# the Sun Valley look travels with the exe instead of silently falling
# back to default ttk.

import importlib.util
import os

from PyInstaller.utils.hooks import collect_all

# App icon (generated by packaging/make_icon.py). PyInstaller embeds it in
# the Windows exe; on Linux the icon= argument is ignored (the AppImage
# carries its own PNG icon instead), so the same spec works on both.
ICON = os.path.join(SPECPATH, "packaging", "icons", "cameramtool.ico")

datas = []
binaries = []
hiddenimports = []

# Packages the app needs at runtime whose data files / submodules
# PyInstaller's import analysis alone would miss:
#   sv_ttk     - the Sun Valley theme's .tcl/.png files
#   reportlab  - PDF export (fonts, lazily imported modules)
# Both are REQUIRED: the build fails if either is not installed. (Before,
# this was best-effort, and because collect_all() on a missing package
# just returns empty lists, CI shipped an exe without reportlab and PDF
# export only said "requires reportlab" at runtime.)
#
# Genuinely optional features are NOT collected here: the CAD importers
# (ezdxf + matplotlib for DXF, PyMuPDF for SVG) are left out of the build
# (PyMuPDF is excluded below) and the app reports them as unavailable.
# packaging/check_bundle.py verifies the finished binary in CI.
REQUIRED_PACKAGES = ("sv_ttk", "reportlab")
for pkg in REQUIRED_PACKAGES:
    if importlib.util.find_spec(pkg) is None:
        raise SystemExit(
            f"ERROR: required package {pkg!r} is not installed in the build "
            f"environment; run: pip install -r requirements.txt")
    d, b, h = collect_all(pkg)
    if not (d or h):
        raise SystemExit(f"ERROR: collect_all({pkg!r}) found nothing to bundle")
    datas += d
    binaries += b
    hiddenimports += h

# Pillow's ImageTk C extension imports PIL._tkinter_finder from C on
# Linux/macOS (to locate the Tk library), which PyInstaller's static
# analysis cannot see; without it every canvas image fails with
# ModuleNotFoundError in the frozen Linux build. Harmless on Windows.
hiddenimports += ["PIL._tkinter_finder"]

a = Analysis(
    ["camera_wire_tool.py"],
    pathex=[],
    binaries=binaries,
    datas=datas,
    hiddenimports=hiddenimports,
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    # Not imported by the app — excluding trims a lot off the exe size.
    # (reportlab is intentionally NOT excluded — PDF export needs it.)
    excludes=["numpy", "pymupdf", "fitz", "pytest", "mypy", "ruff"],
    noarchive=False,
)

pyz = PYZ(a.pure, a.zipped_data)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name="CameraWireTool",
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=ICON,
)
